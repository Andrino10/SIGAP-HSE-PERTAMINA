# Opsional: ganti nomor placeholder dengan nomor WhatsApp resmi format internasional.
WA_HSSE_SUPERINTENDENT=6281234567890
WA_HSSE_SAFETY=6281234567891
WA_HSSE_APD=6281234567891
WA_HSSE_HEIGHT=6281234567891
WA_HSSE_ELECTRICAL=6281234567891
WA_HSSE_HEAVY=6281234567891
WA_HSSE_HEALTH=6281234567892
WA_HSSE_EMERGENCY=6281234567892
WA_HSSE_SECURITY=6281234567893
WA_HSSE_ENVIRO=6281234567894
WA_HSSE_ADMIN=6281234567895

# Opsional untuk lokal. Jangan aktifkan semantic search pada deployment Vercel ringan.
SIGAP_DISABLE_SEMANTIC_SEARCH=1

# Wajib diisi di Vercel untuk autentikasi admin. Nama variabel ADMIN_USERNAME,
# ADMIN_PASSWORD, dan ADMIN_JWT_SECRET versi lama tetap didukung.
SIGAP_ADMIN_USER=admin
SIGAP_ADMIN_PASSWORD=ganti-dengan-password-kuat
SIGAP_ADMIN_SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
