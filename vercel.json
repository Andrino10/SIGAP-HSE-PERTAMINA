{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{frontend/**,backend/data/knowledge.json}",
      "excludeFiles": "{backend/tests/**,frontend/tests/**,backend/scripts/**,backend/data/storage/**,**/__pycache__/**,.pytest_cache/**,requirements-ai.txt}"
    }
  }
}
